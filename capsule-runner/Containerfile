# BornToShare capsule-runner — Dramatiq worker running LDAP, SMB and Kerberos actions
ARG BASE_IMAGE=docker.io/library/python:3.14-slim-trixie
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="borntoshare-capsule-runner" \
      org.opencontainers.image.description="Dramatiq worker running LDAP, SMB and Kerberos actions" \
      org.opencontainers.image.source="https://github.com/RaphPrch/borntoshare"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

# smbclient: smbclient, smbcacls, rpcclient - krb5-user: kinit
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends smbclient krb5-user ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first (cached while requirements.txt is unchanged)
COPY requirements.txt .
RUN pip install -r requirements.txt

# Application code: owned by root, read-only for the runtime user
COPY app ./app
COPY start.sh ./start.sh

# Non-root runtime user, one UID per service
RUN groupadd --system --gid 10003 app \
    && useradd --system --uid 10003 --gid app --no-create-home --shell /usr/sbin/nologin app
USER app

# Dramatiq worker + agent API (port AGENT_PORT, checked by core-service)
EXPOSE 8443
CMD ["./start.sh"]
