# BornToShare secret-broker
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies first (cached while requirements.txt is unchanged)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code: owned by root, read-only for the runtime user
COPY core ./core
COPY providers ./providers
COPY routers ./routers
COPY schemas.py main.py ./

# Non-root runtime user (same UID as "user:" in podman-compose.yml, when set)
RUN useradd -r -u 10004 -g nogroup appuser
USER 10004

EXPOSE 8010
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8010"]
