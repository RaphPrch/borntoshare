# Secret Broker V1
INTERNAL_TOKEN=change-me
B2S_SECRET_ALLOWED_PREFIXES=sm://
B2S_SECRET_ALLOW_ENV_PROVIDER=false
B2S_SECRET_PROVIDER=filesystem
B2S_SECRETS_DIR=/data/secrets
B2S_SECRET_MASTER_KEY=change-me-with-32-byte-base64
B2S_SECRET_ALLOW_WRITE=false
B2S_SECRET_WRITE_TOKEN=change-me-write-token
LOG_LEVEL=INFO
