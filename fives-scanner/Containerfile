# BornToShare fives-scanner — the scanner of the 5S module: walks the folders ON their Windows file servers
# (WinRM, Kerberos, no agent). Built from the root of the repository: it reuses the WinRM code of capsule-runner.
#   podman build -f fives-scanner/Containerfile .
ARG BASE_IMAGE=docker.io/library/python:3.14-slim-trixie

FROM ${BASE_IMAGE} AS kerberos-wheels
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc libkrb5-dev \
    && rm -rf /var/lib/apt/lists/*
COPY capsule-runner/requirements-kerberos.txt .
RUN pip wheel --no-cache-dir --no-deps -w /wheels -r requirements-kerberos.txt

FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.title="borntoshare-fives-scanner" \
      org.opencontainers.image.description="Scanner of the 5S module: server-side walks over WinRM, NTFS change journal, resumable" \
      org.opencontainers.image.source="https://github.com/RaphPrch/borntoshare"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore
# krb5-user: kinit and the GSSAPI library (WinRM)
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends krb5-user ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY fives-scanner/requirements.txt capsule-runner/requirements-kerberos.txt ./
COPY --from=kerberos-wheels /wheels /wheels
RUN pip install -r requirements.txt && pip install --no-index --find-links /wheels -r requirements-kerberos.txt && rm -rf /wheels
# The WinRM session, the server-side walk and the name resolution of capsule-runner (one source for both)
COPY capsule-runner/app/core/__init__.py capsule-runner/app/core/settings.py ./app/core/
COPY capsule-runner/app/shared/__init__.py capsule-runner/app/shared/winrm.py capsule-runner/app/shared/winrm_exec.py capsule-runner/app/shared/server_scan.py capsule-runner/app/shared/name_resolution.py ./app/shared/
COPY capsule-runner/app/services/core_client.py capsule-runner/app/services/secret_client.py ./app/services/
# The pattern of the clutter files (app.actions.smb._JUNK): the module is imported, its SMB tools are never called
COPY capsule-runner/app/actions/__init__.py capsule-runner/app/actions/smb.py ./app/actions/
COPY capsule-runner/app/shared/samba_auth.py ./app/shared/
COPY fives-scanner/scanner ./scanner
RUN groupadd --system --gid 10006 app \
    && useradd --system --uid 10006 --gid app --no-create-home --shell /usr/sbin/nologin app
USER app
CMD ["python", "-m", "scanner"]
