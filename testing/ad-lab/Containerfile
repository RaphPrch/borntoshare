# Test Active Directory for end-to-end tests (Samba 4 AD DC): never for production.
FROM docker.io/library/debian:trixie-slim

RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      samba samba-ad-dc samba-ad-provision samba-dsdb-modules samba-vfs-modules winbind \
      krb5-user ldb-tools smbclient ldap-utils openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Unix ids of the domain objects stay in a small range (shares are on a local volume)
RUN sed -i "s/^lowerBound: 3000000/lowerBound: 30000/; s/^upperBound: 4000000/upperBound: 60000/" \
      /usr/share/samba/setup/idmap_init.ldif

COPY entry.sh seed.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/entry.sh /usr/local/bin/seed.sh

EXPOSE 389 636 445 88

CMD ["/usr/local/bin/entry.sh"]
