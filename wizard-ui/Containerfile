###############################################
# BornToShare Wizard UI — Backend (FastAPI)
# Hardened / Minimal
###############################################

FROM python:3.12-slim

# --------------------------------------------------
# Runtime env (deterministic)
# --------------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/venv/bin:$PATH"

WORKDIR /opt/wizard

# --------------------------------------------------
# Python virtualenv (NO update / NO upgrade)
# --------------------------------------------------
RUN python -m venv /venv

# --------------------------------------------------
# Dependencies
# --------------------------------------------------
COPY requirements.txt .
RUN /venv/bin/pip install --no-cache-dir -r requirements.txt

# --------------------------------------------------
# Backend application only
# --------------------------------------------------
COPY backend ./backend

# --------------------------------------------------
# Non-root user (static UID)
# --------------------------------------------------
RUN useradd -r -u 10005 -g nogroup wizard && \
    chown -R wizard:nogroup /opt/wizard /venv

USER 10005

# --------------------------------------------------
# Runtime
# --------------------------------------------------
EXPOSE 8080
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8080"]
