# BornToShare wizard-ui — database initialization wizard (SQL packs in backend/app/sql)
ARG BASE_IMAGE=docker.io/library/python:3.14-slim-trixie
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="borntoshare-wizard-ui" \
      org.opencontainers.image.description="database initialization wizard (SQL packs in backend/app/sql)" \
      org.opencontainers.image.source="https://github.com/RaphPrch/borntoshare"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /app

# Dependencies first (cached while requirements.txt is unchanged)
COPY requirements.txt .
RUN pip install -r requirements.txt

# Application code: owned by root, read-only for the runtime user
COPY backend ./backend

# Non-root runtime user, one UID per service
RUN groupadd --system --gid 10005 app \
    && useradd --system --uid 10005 --gid app --no-create-home --shell /usr/sbin/nologin app
USER app

EXPOSE 8080
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8080"]
