# ============================================================
# BornToShare — configuration unique (lue par podman-compose.yml)
# Modèle : copier en .env puis remplacer les valeurs « change-me »
# ============================================================

# --- Général
# dev | prod — en prod, les services refusent les clés de développement
APP_ENV=dev
LOG_LEVEL=INFO
# niveau de log de capsule-runner
CAPSULE_LOG_LEVEL=INFO

# --- Authentification entre services (un seul jeton partagé)
# static | hmac
INTERNAL_TOKEN_MODE=static
# mode static : même valeur pour tous les services
INTERNAL_TOKEN=change-me-long-random

# --- Sessions et cookie « principal » (auth-service + frontend)
PRINCIPAL_SIGNING_KEY=change-me-long-random
PRINCIPAL_TTL_SECONDS=900
PRINCIPAL_COOKIE_NAME=b2s_principal
PRINCIPAL_COOKIE_SAMESITE=lax
PRINCIPAL_COOKIE_SECURE=false
SESSION_COOKIE_NAME=b2s_session
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TIMEOUT=1800

# --- Fournisseurs d'authentification (auth-service)
ENABLED_PROVIDERS=["ad","local"]
DEFAULT_AUTH_PROVIDER=ad

# --- Base de données MariaDB (core-service ; la base de logs utilise le même serveur et le même compte)
DB_HOST=mariadb.example.local
DB_PORT=3306
DB_NAME=borntoshare
DB_USER=b2s
DB_PASSWORD=change-me
LOGGING_DB_NAME=borntoshare_logging

# --- Redis — broker Dramatiq (lettres et chiffres uniquement)
REDIS_PASSWORD=changeMeLettersAndDigitsOnly

# --- secret-broker
B2S_SECRET_MASTER_KEY=change-me-base64-32-bytes
# partagé avec auth-service
B2S_SECRET_WRITE_TOKEN=change-me-long-random
B2S_SECRET_ALLOW_WRITE=true

# --- Frontend
# URL publique de l'application (ORIGIN de SvelteKit)
FRONTEND_PUBLIC_ORIGIN=https://borntoshare.example.local
FRONTEND_PUBLISHED_PORT=3000
B2S_USE_HTTPS=false

# --- capsule-runner
RUNNER_MAX_SCOPE=write
# Agent of the worker: core-service checks it with these credentials (same values in
# Advanced Settings › Infrastructure › Workers). HTTPS (port 8443) with AGENT_TLS_CERT / AGENT_TLS_KEY (PEM),
# HTTP (port 8080) without them: internal network only. AGENT_PORT changes the port.
AGENT_USERNAME=b2s-agent
AGENT_PASSWORD=change-me-agent-password
AGENT_TLS_CERT=
AGENT_TLS_KEY=
AGENT_PORT=
# Authority of the agents' certificates when private (path inside core-service, e.g. /etc/b2s/certs/agent-ca.pem)
B2S_AGENT_CA_FILE=
# Authority of the Keycloak servers' certificates when private (path inside auth-service), SSO
B2S_OIDC_CA_FILE=

# --- Wizard
WIZARD_PORT=8080
WIZARD_MODE=dev

