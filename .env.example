# ============================================================
# BornToShare — configuration unique (lue par podman-compose.yml)
# Copier en .env (chmod 600), puis remplacer chaque valeur « change-me ».
# Chaque conteneur ne reçoit que les variables qu'il lit. Détails : docs/installation.md
# Générer un secret : openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# ============================================================

# --- Jeton partagé entre les services (en-tête X-Internal-Token) : au moins 32 caractères aléatoires
INTERNAL_TOKEN=change-me-long-random

# --- Signature du cookie de session « principal » (auth-service et frontend) : au moins 32 caractères aléatoires.
# Obligatoire : auth-service et le frontend refusent de démarrer avec la clé par défaut
PRINCIPAL_SIGNING_KEY=change-me-long-random

# --- Base de données MariaDB externe (core-service et wizard ; la base des journaux est sur le même serveur, même compte)
# Après le wizard, Réglages avancés › Infrastructure › Base de données peut la remplacer (config/runtime, lu au démarrage)
DB_HOST=mariadb.example.local
DB_PORT=3306
DB_NAME=borntoshare
DB_USER=b2s_app
DB_PASSWORD=change-me
LOGGING_DB_NAME=borntoshare_logging

# --- Redis : file des travaux (Dramatiq) et sessions des utilisateurs. Lettres et chiffres uniquement
REDIS_PASSWORD=changeMeLettersAndDigitsOnly

# --- Clé de chiffrement (AES-GCM) des mots de passe stockés en base : 32 octets en base64 (openssl rand -base64 32).
# À SAUVEGARDER À PART de la base : sans elle, aucun mot de passe stocké ne se relit.
B2S_SECRET_MASTER_KEY=change-me-base64-32-bytes

# --- Frontend : URL publique de l'application (ORIGIN de SvelteKit) et port publié sur l'hôte
FRONTEND_PUBLIC_ORIGIN=https://borntoshare.example.local
FRONTEND_PUBLISHED_PORT=3000

# --- capsule-runner (worker)
# read | write : write autorise les modifications (groupes AD, ACL, partages, DFS), read donne un worker de lecture seule
RUNNER_MAX_SCOPE=write
# Certificats (facultatifs), à déposer dans capsule-runner/certs/ (monté en /etc/b2s/certs) — pas de variable :
#   agent.crt + agent.key  agent du worker en HTTPS (8443) ; sans eux, HTTP sur 8080, réseau interne uniquement
#   agent-ca.pem           autorité privée des certificats d'agent (lue par core-service)
#   oidc-ca.pem            autorité privée des serveurs Keycloak (lue par auth-service), pour le SSO

# --- Wizard d'installation (make wizard, puis make wizard-down) : il crée les bases et les comptes ci-dessus et
# ci-dessous, en partant de leurs noms ; les mots de passe se saisissent dans le wizard, puis se reportent ici
WIZARD_PORT=8080

# --- Module 5S (sous licence) : ses deux bases et son propre compte, sur le même serveur. Sans FIVES_DB_PASSWORD,
# make deploy ne démarre pas le module
FIVES_DB_NAME=b2s_fives
FIVES_INVENTORY_DB_NAME=b2s_fives_inventory
FIVES_DB_USER=b2s_fives
FIVES_DB_PASSWORD=

# B2S_VERSION n'est pas à renseigner : make deploy y met le commit et la date, affichés en bas du menu
