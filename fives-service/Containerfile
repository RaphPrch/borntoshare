# BornToShare fives-service — the optional 5S and data hygiene module (its own databases, licensed)
ARG BASE_IMAGE=docker.io/library/python:3.14-slim-trixie
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="borntoshare-fives-service" \
      org.opencontainers.image.description="5S and data hygiene module: scores, duplicates, growth, reports (licensed)" \
      org.opencontainers.image.source="https://github.com/RaphPrch/borntoshare"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app ./app

# Non-root runtime user, one UID per service
RUN groupadd --system --gid 10005 app \
    && useradd --system --uid 10005 --gid app --no-create-home --shell /usr/sbin/nologin app
USER app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
