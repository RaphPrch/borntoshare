{
  "name": "borntoshare-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js dev",
    "build": "LC_ALL=C LANG=C node ./node_modules/vite/bin/vite.js build --logLevel error",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:auth-snapshot": "npx tsx ./src/lib/server/auth/principal-cookie.test.ts && npx tsx ./src/hooks.server.test.ts",
    "test:identity-sources-mapper": "npx tsx ./src/lib/mappers/identity-sources.mapper.test.ts",
    "test:principal-search": "npx tsx ./src/lib/utils/principal-search.test.ts",
    "test:request-decision-errors": "npx tsx ./src/lib/utils/request-decision-errors.test.ts",
    "test:entity-operational-mapper": "npx tsx ./src/lib/mappers/entity-operational.mapper.test.ts",
    "test:storage-root-governance": "npx tsx ./src/lib/utils/storage-root-governance.test.ts",
    "test:storage-root-alerts": "npx tsx ./src/lib/mappers/storage-root-alerts.mapper.test.ts",
    "test:storage-root-detail-mapper": "npx tsx ./src/lib/mappers/storage-root-detail.mapper.test.ts",
    "test:storage-endpoint-provisioning-mapper": "npx tsx ./src/lib/mappers/storage-endpoint-provisioning.mapper.test.ts",
    "test:visual-state-mapper": "npx tsx ./src/lib/mappers/visual-state.mapper.test.ts",
    "test:delete-guard": "npx tsx ./src/lib/utils/delete-guard.test.ts",
    "test:identity-browser-api": "npx tsx ./src/lib/api/identity-browser.test.ts",
    "test:entity-status-mapper": "npx tsx ./src/lib/mappers/entity-status.mapper.test.ts",
    "test:ad-browse": "npx tsx ./src/lib/utils/ad-browse.test.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.0.0",
    "vite": "^6.4.1"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "svelte-check": "^4.1.4",
    "typescript": "^5.6.3"
  }
}
