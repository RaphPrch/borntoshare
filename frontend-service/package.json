{
  "name": "borntoshare-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo \"\"",
    "dev": "node ./node_modules/vite/bin/vite.js dev",
    "build": "LC_ALL=C LANG=C node ./node_modules/vite/bin/vite.js build --logLevel error",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:auth-snapshot": "npx tsx ./src/lib/server/auth/principal-cookie.test.ts && npx tsx ./src/hooks.server.test.ts",
    "test:identity-sources-mapper": "npx tsx ./src/lib/mappers/identity-sources.mapper.test.ts",
    "test:principal-search": "npx tsx ./src/lib/utils/principal-search.test.ts",
    "test:zone-summary": "npx tsx ./src/lib/components/zones/zone-summary.test.ts",
    "test:dfs-namespace": "npx tsx ./src/lib/components/storage-endpoints/dfs-namespace.test.ts",
    "test:activity-timeline": "npx tsx ./src/lib/activity/timeline.test.ts",
    "test:error-normalize": "npx tsx ./src/lib/errors/normalize.test.ts",
    "test:request-decision-errors": "npx tsx ./src/lib/utils/request-decision-errors.test.ts",
    "test:entity-operational-mapper": "npx tsx ./src/lib/mappers/entity-operational.mapper.test.ts",
    "test:storage-root-governance": "npx tsx ./src/lib/utils/storage-root-governance.test.ts",
    "test:storage-root-alerts": "npx tsx ./src/lib/mappers/storage-root-alerts.mapper.test.ts",
    "test:storage-root-detail-mapper": "npx tsx ./src/lib/mappers/storage-root-detail.mapper.test.ts",
    "test:storage-endpoint-provisioning-mapper": "npx tsx ./src/lib/mappers/storage-endpoint-provisioning.mapper.test.ts",
    "test:visual-state-mapper": "npx tsx ./src/lib/mappers/visual-state.mapper.test.ts",
    "test:delete-guard": "npx tsx ./src/lib/utils/delete-guard.test.ts",
    "test:identity-browser-api": "npx tsx ./src/lib/api/identity-browser.test.ts",
    "test:entity-status-mapper": "npx tsx ./src/lib/mappers/entity-status.mapper.test.ts",
    "test:ad-browse": "npx tsx ./src/lib/utils/ad-browse.test.ts",
    "test:service-accounts": "npx tsx ./src/lib/utils/service-accounts.test.ts",
    "test:folder-query": "npx tsx ./src/lib/components/storage-roots/folder-query.test.ts",
    "test:request-sentence": "npx tsx ./src/lib/utils/request-sentence.test.ts",
    "test:tag-colors": "npx tsx ./src/lib/utils/tag-colors.test.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:pilot-engine": "npx tsx ./src/lib/components/pilot/pilot-engine.test.ts",
    "test:diagnostics": "npx tsx ./src/lib/utils/diagnostics.test.ts",
    "test:acl-preview": "npx tsx ./src/lib/utils/acl-preview.test.ts",
    "test:error-messages": "npx tsx ./src/lib/errors/presenters.test.ts",
    "test:actor-assertion": "npx tsx ./src/lib/server/auth/actor-assertion.test.ts",
    "test:navigation": "npx tsx ./src/lib/components/layout/nav.test.ts && npx tsx ./src/lib/utils/route-access.test.ts",
    "test:access-explorer": "npx tsx ./src/lib/utils/access-explain.test.ts",
    "test:storage-topology": "npx tsx ./src/lib/utils/storage-topology.test.ts"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "simple-icons": "^16.38.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  }
}
