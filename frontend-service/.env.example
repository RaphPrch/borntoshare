# ================================
# BornToShare — Frontend (V1)
# ================================

# --------------------------------
# Logging / Debug
# --------------------------------
LOG_LEVEL=INFO

# --------------------------------
# Backend service URLs (SERVER ONLY)
# Used by hooks.server.ts (BFF)
# --------------------------------
B2S_AUTH_URL=http://auth-service:8000
B2S_DAL_URL=http://dal-service:8000
B2S_GOVERNANCE_URL=http://governance-service:8000
B2S_SECRET_BROKER_URL=http://secret-broker:8010

# --------------------------------
# Security (V1)
# --------------------------------
B2S_USE_HTTPS=false
B2S_CSRF_ENABLED=false
SESSION_COOKIE_NAME=b2s_session
PRINCIPAL_COOKIE_NAME=b2s_principal
PRINCIPAL_TTL_SECONDS=900
PRINCIPAL_SIGNING_KEY=dev-principal-signing-key-change-me
PRINCIPAL_COOKIE_SAMESITE=lax
PRINCIPAL_COOKIE_SECURE=false

# --------------------------------
# Frontend direct exposure (without Traefik)
# --------------------------------
# Host port published by podman-compose (host:container)
FRONTEND_PUBLISHED_PORT=3000

# Public origin of the frontend for cookie/url generation by adapter-node
# HTTP example : http://localhost:3000
# HTTPS example: https://frontend.example.local
FRONTEND_PUBLIC_ORIGIN=http://localhost:3000
