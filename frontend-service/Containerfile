# BornToShare frontend (SvelteKit, adapter-node)

# ---------- Build ----------
FROM node:22-alpine AS build
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
# NODE_ENV=production: devDependencies (svelte-check, typescript) are not installed
RUN npm ci

COPY . .
RUN npm run build

# ---------- Runtime ----------
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app

# Runtime artifacts only, owned by root (read-only for the app user)
COPY --from=build /app/build ./build
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules

USER app
EXPOSE 3000
CMD ["node", "build/index.js"]
