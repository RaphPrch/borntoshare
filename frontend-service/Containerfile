# BornToShare frontend-service — SvelteKit UI and BFF (adapter-node)
ARG BASE_IMAGE=docker.io/library/node:26-alpine3.24

# ---------- Build ----------
FROM ${BASE_IMAGE} AS build
WORKDIR /app

COPY package.json package-lock.json ./
# Every package is a devDependency: adapter-node bundles them into build/
RUN npm ci --no-fund --no-audit

COPY . .
RUN npm run build

# ---------- Runtime ----------
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="borntoshare-frontend-service" \
      org.opencontainers.image.description="SvelteKit UI and BFF (adapter-node)" \
      org.opencontainers.image.source="https://github.com/RaphPrch/borntoshare"

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000
WORKDIR /app

# Runtime artifacts only (self-contained bundle, no node_modules), owned by root
COPY --from=build /app/build ./build
COPY --from=build /app/package.json ./package.json

# Non-root runtime user, one UID per service
RUN addgroup -S -g 10006 app \
    && adduser -S -D -H -h /app -s /sbin/nologin -u 10006 -G app app
USER app

EXPOSE 3000
CMD ["node", "build/index.js"]
