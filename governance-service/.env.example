##########################################
# 🧩 Application
##########################################
APP_ENV=dev
LOG_LEVEL=INFO

##########################################
# 🧠 Upstreams
##########################################
DAL_URL=http://dal-service:8000

##########################################
# 🧩 Edition & Orchestrator
##########################################
B2S_EDITION=community
CAPSULE_BROKER_URL=redis://redis:6379/2

##########################################
# 🔐 Internal token (service-to-service) — V1 default (HMAC)
##########################################
INTERNAL_TOKEN_MODE=hmac
# Rotation-ready keyring format: kid1:secret1,kid2:secret2
INTERNAL_TOKEN_KEYS=k1:change-me-32b-min
INTERNAL_TOKEN_TTL_SEC=300

# Optional dev-only static mode (disable in prod)
# INTERNAL_TOKEN_MODE=static
# INTERNAL_TOKEN=dev-internal-token
